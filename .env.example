# SurveyOS Prime V2 — Environment Variables
#
# Copy this file to .env.local and fill in the real values.
# Get all values from Firebase Console → Project Settings.
# NEVER commit .env.local to git.

# Firebase (Web App Config)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Drive OAuth (Google Cloud Console → APIs → Credentials)
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com

# Admin (Firebase Console → Authentication → find your UID)
NEXT_PUBLIC_MASTER_ADMIN_UID=your_firebase_uid

# NVIDIA API (optional — only needed if using NVIDIA AI features)
NVIDIA_API_KEY=your_nvidia_api_key
