{
  "portal": "nia",
  "flow": "nontieup",
  "version": 3,
  "host": "web.newindia.co.in",
  "route": "#/WorklistSurveyNew",
  "doneHint": "Now click Validate on the portal to load the Excel lines, then check the totals.",
  "modelRoot": "surveyorData.worklist.",
  "controller": "surveyorWorklistSurveyCtrl",
  "claimNoPath": "surveyorData.worklist.viewClaimDetails.claimDetails.claimNumber",
  "claimNoFallback": "sessionStorage:claimNoForWorklist",
  "invoiceCountPath": "surveyorData.worklist.multiInvoice",
  "fields": {
    "surveyDateRadio":  { "model": "surveyorData.worklist.quickUpdate.surveyDateRadio", "label": "Survey date choice", "kind": "dateRadioOrOthers", "from": "surveyDate", "empty": null },
    "surveyDate":       { "model": "surveyorData.worklist.quickUpdate.surveyDate", "label": "Survey date", "kind": "text", "transform": "ddmmyyyy", "empty": null },
    "surveyTime":       { "model": "surveyorData.worklist.quickUpdate.timeOfSurvey", "label": "Survey time", "kind": "text", "transform": "hhmm", "empty": "" },
    "surveyPlace":      { "model": "surveyorData.worklist.quickUpdate.placeOfSurvey", "label": "Place of survey", "kind": "text", "empty": "", "maxLen": 100 },
    "claimantMobile":   { "model": "surveyorData.worklist.quickUpdate.claimantMobileNo", "label": "Claimant mobile", "kind": "text", "empty": "" },
    "claimantEmail":    { "model": "surveyorData.worklist.quickUpdate.claimantEmailId", "label": "Claimant email", "kind": "text", "empty": "" },
    "noOfInvoices":     { "model": "surveyorData.worklist.claimAssessment.noOfInvoices", "label": "No. of invoices", "kind": "select", "empty": "" },
    "gstApplicable":    { "model": "surveyorData.worklist.multiInvoice[$index].isGstApplicable", "label": "GST applicable (invoice)", "kind": "select", "empty": "", "options": { "Y": "Y", "N": "N" } },
    "vendorInvoiceNo":  { "model": "surveyorData.worklist.multiInvoice[$index].vendorTaxInvoiceNumber", "label": "Vendor invoice no.", "kind": "text", "empty": "", "maxLen": 30 },
    "vendorInvoiceDate":{ "model": "surveyorData.worklist.multiInvoice[$index].vendorTaxInvoiceDate", "label": "Vendor invoice date", "kind": "text", "transform": "ddmmyyyy", "empty": null },
    "paintingWork":     { "model": "surveyorData.worklist.multiInvoice[$index].paintingWorkDetails", "label": "Painting work details", "kind": "select", "constant": "Consolidated", "onlyIf": "paintingAssessed", "empty": "" },
    "paintingEstimate": { "model": "surveyorData.worklist.multiInvoice[$index].estimatedAmount", "label": "Painting estimated amount", "kind": "money", "empty": "" },
    "paintingAssessed": { "model": "surveyorData.worklist.multiInvoice[$index].assessedAmount", "label": "Painting assessed amount", "kind": "money", "empty": "" },
    "netSalvage":       { "model": "surveyorData.worklist.claimAssessment.netSlavage", "label": "Net salvage", "kind": "money", "empty": "" },
    "compulsoryExcess": { "model": "surveyorData.worklist.claimAssessment.lessCompulsoryExcess", "label": "Compulsory excess", "kind": "money", "empty": "" },
    "voluntaryExcess":  { "model": "surveyorData.worklist.claimAssessment.lessVoluntaryExpress", "label": "Voluntary excess", "kind": "money", "empty": "" },
    "feeInvoiceDate":   { "model": "surveyorData.worklist.surveyFeeBill.surveyorFeeInvoiceDate", "label": "Fee invoice date", "kind": "text", "transform": "ddmmyyyy", "empty": null },
    "professionalFee":  { "model": "surveyorData.worklist.surveyFeeBill.professionalFee", "label": "Professional fee", "kind": "money", "empty": "" },
    "photosAmount":     { "model": "surveyorData.worklist.surveyFeeBill.photosAmount", "label": "Photographs", "kind": "money", "empty": "" },
    "conveyanceAmount": { "model": "surveyorData.worklist.surveyFeeBill.conveyanceAmount", "label": "Conveyance", "kind": "money", "empty": "" },
    "feeOthers":        { "model": "surveyorData.worklist.surveyFeeBill.others", "label": "Other charges (fee)", "kind": "money", "empty": "" },
    "feeGstApplicable": { "model": "surveyorData.worklist.surveyFeeBill.isGSTApplicable", "label": "GST applicable (fee)", "kind": "select", "empty": "", "options": { "Y": "Y", "N": "N" } },
    "feeGstPercent":    { "model": "surveyorData.worklist.surveyFeeBill.gstPercent", "label": "GST % (fee)", "kind": "text", "empty": "" }
  },
  "files": {
    "assessmentExcel":  { "model": "surveyorData.worklist.multiInvoice[$index].myFiles" }
  }
}
