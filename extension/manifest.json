{
  "manifest_version": 3,
  "name": "SurveyOS Portal Fill",
  "version": "0.2.0",
  "description": "Fills the New India surveyor portal from a finished SurveyOS claim. Never submits, never sees your login.",
  "minimum_chrome_version": "111",
  "icons": { "128": "icons/icon128.png" },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://motorsurveyos-in.web.app/*",
    "https://web.newindia.co.in/NIABancsPortal/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://motorsurveyos-in.web.app/*", "http://localhost:3000/*"],
      "js": ["src/lib/packet-validate.js", "src/relay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.newindia.co.in/NIABancsPortal/*"],
      "js": ["src/lib/fill-core.js", "src/panel.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.newindia.co.in/NIABancsPortal/*"],
      "js": ["src/lib/fill-core.js", "src/filler.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
