{
  "manifest_version": 3,
  "name": "SurveyOS Portal Fill",
  "version": "0.4.0",
  "description": "Fills insurer surveyor portals (New India, United India, Oriental) from a finished SurveyOS claim. Never submits, never sees your login.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://surveyos.in/*",
    "https://motorsurveyos-in.web.app/*",
    "https://web.newindia.co.in/NIABancsPortal/*",
    "https://portal.uiic.in/surveyor/*",
    "https://orientalinsurance.org.in/*",
    "https://*.nationalinsurance.nic.co.in/*",
    "https://*.icicilombard.com/*",
    "https://*.bajajallianz.com/*",
    "https://*.hdfcergo.com/*",
    "https://*.tataaig.com/*",
    "https://*.godigit.com/*",
    "https://*.sbigeneral.in/*",
    "https://*.chola.in/*",
    "https://*.reliancegeneral.co.in/*",
    "https://*.iffcotokio.com/*",
    "https://*.futuregenerali.in/*",
    "https://*.royalsundaram.in/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://surveyos.in/*",
        "https://motorsurveyos-in.web.app/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "src/lib/packet-validate.js",
        "src/relay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.newindia.co.in/NIABancsPortal/*",
        "https://portal.uiic.in/surveyor/*",
        "https://orientalinsurance.org.in/*",
        "https://*.nationalinsurance.nic.co.in/*",
        "https://*.icicilombard.com/*",
        "https://*.bajajallianz.com/*",
        "https://*.hdfcergo.com/*",
        "https://*.tataaig.com/*",
        "https://*.godigit.com/*",
        "https://*.sbigeneral.in/*",
        "https://*.chola.in/*",
        "https://*.reliancegeneral.co.in/*",
        "https://*.iffcotokio.com/*",
        "https://*.futuregenerali.in/*",
        "https://*.royalsundaram.in/*"
      ],
      "js": [
        "src/lib/fill-core.js",
        "src/lib/inverter.js",
        "src/lib/observer.js",
        "src/lib/learned-store.js",
        "src/lib/card-view.js",
        "src/panel.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.newindia.co.in/NIABancsPortal/*",
        "https://portal.uiic.in/surveyor/*",
        "https://orientalinsurance.org.in/*",
        "https://*.nationalinsurance.nic.co.in/*",
        "https://*.icicilombard.com/*",
        "https://*.bajajallianz.com/*",
        "https://*.hdfcergo.com/*",
        "https://*.tataaig.com/*",
        "https://*.godigit.com/*",
        "https://*.sbigeneral.in/*",
        "https://*.chola.in/*",
        "https://*.reliancegeneral.co.in/*",
        "https://*.iffcotokio.com/*",
        "https://*.futuregenerali.in/*",
        "https://*.royalsundaram.in/*"
      ],
      "js": [
        "src/lib/fill-core.js",
        "src/lib/inverter.js",
        "src/lib/learned-store.js",
        "src/filler.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SurveyOS Portal Fill",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}