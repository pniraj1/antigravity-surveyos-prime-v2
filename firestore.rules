rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Role-based admin check — reads isAdmin flag from the user's own profile.
    // Any user can be promoted to admin by setting isAdmin: true in their profile.
    // The master admin (same UID as NEXT_PUBLIC_MASTER_ADMIN_UID) is always admin,
    // so a stray write to their profile can never lock the owner out — and
    // useAuth's self-heal can then put isAdmin back on their profile.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'QCgRlZdGF3etljVitH8xq3KsTqB2' || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)/profile/current) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/current).data.isAdmin == true
        )
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Subscription gate (server-side authorization) ──────────────────
    // The client (SubscriptionGuard) only DRAWS the locked/expired screens;
    // it is not a security boundary. This is. A signed-in user may only WRITE
    // their own claim data while their profile status is 'active' or 'trial'.
    // 'pending' (unapproved), 'suspended', 'readonly', 'expired' → read-only.
    //
    // ponytail: status-only check — an 'active' profile with a PAST subscriptionExpiry
    // (an ISO string) still passes, because rules can't compare an ISO string to
    // wall-clock time. In practice useAuth flips expired→'readonly' on next login,
    // and the expensive path (callAI) re-checks expiry in JS. Upgrade path if this
    // matters: store subscriptionExpiry as a number/Timestamp and compare to
    // request.time here, or a scheduled function that flips expired→readonly.
    function isTeamMember(ownerUid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(ownerUid)/profile/current) &&
        'teamEmails' in get(/databases/$(database)/documents/users/$(ownerUid)/profile/current).data &&
        request.auth.token.email != null &&
        request.auth.token.email in get(/databases/$(database)/documents/users/$(ownerUid)/profile/current).data.teamEmails;
    }

    function hasOwnerActiveAccess(ownerUid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/profile/current) &&
        get(/databases/$(database)/documents/users/$(ownerUid)/profile/current)
          .data.subscriptionStatus in ['active', 'trial'];
    }

    // AI Configuration — admin-only (contains master API keys)
    match /ai_config/routing {
      allow read, write: if isAdmin();
    }

    // AI model catalog — admin curates, all signed-in surveyors read.
    // Contains NO secrets (model ids/labels only); keys stay per-user.
    match /ai_config/models {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // AI model probe results — admin writes, all signed-in surveyors read.
    // Contains NO secrets (model ids and measured capabilities only). Surveyors
    // read it so the request path can size vision chunks to a model's real
    // image cap rather than a hardcoded guess.
    match /ai_config/model_probes {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Survey fee schedule — admin sets the org default, all signed-in surveyors read.
    match /fee_config/schedule {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Announcements — admin broadcasts, all signed-in surveyors read.
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Portal Fill Community Consensus — anonymous structural fingerprints (zero PII)
    match /portalConsensus/{portalFlow} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() || isAdmin();
    }

    // New signup notifications — users create their own entry on first login,
    // and can update it when they submit the access-request form (adds name,
    // IRDAI licence, phone). Only admins can read or delete entries.
    match /newSignups/{uid} {
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow read, delete: if isAdmin();
    }

    // Parser-miss samples: a declined digital estimate/bill, kept ≤15 days for parser work.
    // Surveyors create only (re-sending the same file = update = denied, which de-duplicates it). Admin reads and deletes.
    // ponytail: active/trial accounts only; pieces must arrive in the same batch as their sample (getAfter). TTL bounds the cost. Add a per-uid daily cap if abused.
    match /parserSamples/{id} {
      allow create: if isSignedIn()
        && hasOwnerActiveAccess(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','docType','fileName','reason','pages','size','chunks','createdAt','expireAt'])
        && request.resource.data.docType in ['estimate', 'final-bill']
        && request.resource.data['size'] <= 6000000   // bracket form: `.size` reads like the map's size() method
        && request.resource.data.chunks is int && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 9
        && request.resource.data.fileName is string && request.resource.data.fileName.size() <= 300
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500
        && request.resource.data.pages is int
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt <= request.time + duration.value(16, 'd');
      allow read, delete: if isAdmin();

      match /parserSampleChunks/{i} {
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/parserSamples/$(id)).data.uid == request.auth.uid
          && request.resource.data.i is int && string(request.resource.data.i) == i
          && request.resource.data.i < getAfter(/databases/$(database)/documents/parserSamples/$(id)).data.chunks
          && request.resource.data.keys().hasOnly(['i','uid','data','expireAt'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 900000
          && request.resource.data.expireAt is timestamp
          && request.resource.data.expireAt <= request.time + duration.value(16, 'd');
        allow read, delete: if isAdmin();
      }
    }

    // Collection Group query support for Admin Panel
    match /{path=**}/profile/{docId} {
      allow read, write: if isAdmin();
    }

    // Collection Group query for payments — admin can read all payments across users
    match /{path=**}/payments/{paymentId} {
      allow read: if isAdmin();
    }

    // Team directory — maps an assistant's email to the senior surveyor's firmOwnerUid.
    // Allows an assistant to find their firm's workspace on login.
    match /team_members/{email} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (request.auth.token.email != null && request.auth.token.email.lower() == email.lower()) ||
        (resource != null && resource.data.firmOwnerUid == request.auth.uid)
      );
      allow create: if isAdmin() || (
        isSignedIn() && request.resource.data.firmOwnerUid == request.auth.uid
      );
      allow update: if isAdmin() || (
        isSignedIn() && (
          (resource != null && resource.data.firmOwnerUid == request.auth.uid) ||
          request.resource.data.firmOwnerUid == request.auth.uid
        )
      );
      allow delete: if isAdmin() || (
        isSignedIn() && resource != null && resource.data.firmOwnerUid == request.auth.uid
      );
    }

    // User-specific data — each user accesses only their own data
    match /users/{userId} {
      // 1. Profile — protected so users can't grant themselves admin OR paid access.
      //    The "money fields" below are writable ONLY by an admin (via the payment
      //    verification / admin panel, which run in an admin session). A non-admin
      //    may still edit their own name, keys, bank details, etc.
      match /profile/{docId} {
        allow read: if (isSignedIn() && (request.auth.uid == userId || isTeamMember(userId))) || isAdmin();

        allow create: if isAdmin() || (
          isSignedIn() && request.auth.uid == userId &&
          (!request.resource.data.keys().hasAny(['isAdmin']) || request.resource.data.isAdmin == false) &&
          (
            // Normal new-user create: cannot self-grant paid access.
            (
              request.resource.data.get('subscriptionStatus', 'pending') in ['pending', 'readonly'] &&
              request.resource.data.get('subscriptionExpiry', null) == null &&
              request.resource.data.get('trialStartDate', null) == null &&
              request.resource.data.get('trialEndDate', null) == null
            )
            ||
            // Legacy profile/main → profile/current migration: status must match the
            // existing admin-controlled main doc (a user can't forge main either).
            (
              docId == 'current' &&
              exists(/databases/$(database)/documents/users/$(userId)/profile/main) &&
              request.resource.data.subscriptionStatus ==
                get(/databases/$(database)/documents/users/$(userId)/profile/main).data.subscriptionStatus
            )
          )
        );

        allow update: if isAdmin() || (
          isSignedIn() && request.auth.uid == userId &&
          // A non-admin may never touch admin/grant fields...
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isAdmin', 'maxTeamSeats', 'subscriptionExpiry', 'trialStartDate', 'trialEndDate', 'lastPaymentDate']) &&
          // ...and may only change their own subscriptionStatus DOWN to 'readonly'
          // (this is the useAuth expired→readonly auto-transition; never an upgrade).
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionStatus']) ||
            request.resource.data.subscriptionStatus == 'readonly'
          )
        );

        allow delete: if isAdmin();
      }

      // 2. Payments — users can create and read, only admin can verify/update/delete.
      match /payments/{paymentId} {
        allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update, delete: if isAdmin();
      }

      // 3. All other user data (claims, photos, session, etc).
      //    READ: any signed-in owner — so expired/readonly/suspended users can still
      //          SEE their existing claims (matches the read-only overlay intent).
      //    WRITE: requires active access, EXCEPT the single-session presence doc,
      //           which must work regardless of subscription so the one-device lock
      //           still functions for read-only users.
      match /{collectionId}/{document=**} {
        allow read: if isAdmin() || (
          isSignedIn() && (request.auth.uid == userId || isTeamMember(userId)) &&
          collectionId != 'profile' && collectionId != 'payments'
        );
        allow write: if isAdmin() || (
          isSignedIn() &&
          collectionId != 'profile' && collectionId != 'payments' &&
          (
            (request.auth.uid == userId && collectionId == 'session') ||
            (collectionId == 'claim_presence' && (request.auth.uid == userId || isTeamMember(userId))) ||
            ((request.auth.uid == userId || isTeamMember(userId)) && hasOwnerActiveAccess(userId))
          )
        );
      }
    }

    // Legacy support
    match /claims/{claimId} {
      allow read, write: if false; // Migrated to users/{uid}/claims
    }
  }
}
