# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local
.env*.local
.env.india

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev/test scripts (may contain env vars, local paths)
test_extraction.py
photosheetsforreview_extracted/

# code review graph ignores
.firebase/
tmp_pdf/
.claude/
.cursor/
.code-review-graph/
.agent/
# graphify: KEEP the graph artefacts tracked (graph.json / graph.html /
# GRAPH_REPORT.md). They are what the graphify MCP tools read instead of
# grepping the tree, so a fresh clone that lacks them loses that until someone
# re-runs /graphify. Ignore only the regenerable chunk cache and scratch.
.graphify_*
.graphify_python
graphify-out/cache/
graphify-out/gen_chunks.py
graphify-out/cost.json

# sample/demo documents (large binaries, not needed in repo)
docs/samples/*.pdf
docs/samples/*.zip
docs/samples/*.txt
docs/archives/

# external reference repos (not part of this project)
open-design/

# vector database (regenerated, not source)
ruvector.db

# python virtual environment
.venv/

# functions build artifacts
functions/node_modules/

# claude-flow plugin data
.claude-flow/
